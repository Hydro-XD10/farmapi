# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-generated-secret-key-here

# DEBUG defaults to False (fail-safe). Turn it ON for local development:
DJANGO_DEBUG=True

# Optional (sensible dev defaults in settings.py):
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost         # comma-separated; add your domain in production
# DJANGO_CORS_ORIGINS=https://app.example.com      # production only; comma-separated browser origins
